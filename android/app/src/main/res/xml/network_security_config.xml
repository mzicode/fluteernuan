<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.31.2</domain>
        <domain includeSubdomains="true">192.168.31.10</domain>
        <domain includeSubdomains="true">192.168.31.242</domain>
        <domain includeSubdomains="true">ojyvn.com</domain>
        <domain includeSubdomains="true">iexici.cn</domain>
    </domain-config>
</network-security-config>
